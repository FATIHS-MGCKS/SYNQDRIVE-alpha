{
  "openapi": "3.0.3",
  "info": {
    "title": "One Auto API",
    "description": "Subscribe and generate an api key on our website: [https://www.oneautoapi.com](https://www.oneautoapi.com)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://sandbox.oneautoapi.com",
