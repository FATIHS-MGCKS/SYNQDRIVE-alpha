        "description": "Returns OE sourced vehicle details from a VIN including engine, transmission,  trim level,  interior and exterior colour. ",
        "parameters": [
          {
            "name": "vehicle_identification_number",
            "in": "query",
            "description": "Vehicle identification number (VIN).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
