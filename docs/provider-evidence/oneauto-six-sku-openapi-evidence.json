  "paths": {
    "/ezyvin/servicehistory/": {
      "get": {
        "tags": [
          "Ezyvin"
        ],
        "operationId": "ezyvin_servicehistory",
        "summary": "Service History from VIN",
        "description": "Retrieve digital service history data from 31 manufacturers with full European coverage. ",
        "parameters": [
          {
            "name": "vehicle_identification_number",
            "in": "query",
            "description": "Vehicle identification number (VIN).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "callback_url",
            "in": "query",
            "description": "The callback URL",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_data_in_callback",
            "in": "query",
            "description": "Whether the callback should contain the data from the result.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true,
                      "description": "Whether the api call was successful"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "vehicle_identification_number": {
                          "type": "string",
                          "example": "ABCDE123456F78910",
                          "description": "Vehicle identification number (VIN)."
                        },
                        "service_events": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "date_of_service_event": {
                                "type": "string",
                                "example": "2019-10-21",
                                "description": "Date of service."
                              },
                              "mileage_observed": {
                                "type": "integer",
                                "example": 69343,
                                "description": "Vehicle odometer reading"
                              },
                              "mileage_unit": {
                                "type": "string",
                                "example": "km",
                                "description": "The mileage unit."
                              },
                              "service_provider": {
                                "type": "string",
                                "example": "Premier Service Centre, 2 York Road, Leicester, LE4 9LS, United Kingdom",
                                "description": "Service provider."
                              },
                              "service_type": {
                                "type": "string",
                                "example": "service",
                                "description": "Service type."
                              },
                              "service_actions": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "error": {
                      "type": "string",
                      "example": "If there is an error the message would go here",
                      "description": "Details of what went wrong with the api call"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "x-api-key": []
          }
        ]
      }
    },
    "/oneauto/oeserviceschedulefromvin/v2": {
      "get": {
        "tags": [
          "One Auto API"
        ],
        "operationId": "oneauto_oeserviceschedulefromvin",
        "summary": "OE Service Schedule from VIN",
        "description": "OE service schedule data including detailed work actions, times and parts requirements,  with comprehensive coverage. ",
        "parameters": [
          {
            "name": "vehicle_identification_number",
            "in": "query",
            "description": "Vehicle identification number (VIN).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "callback_url",
            "in": "query",
            "description": "The callback URL",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_data_in_callback",
            "in": "query",
            "description": "Whether the callback should contain the data from the result.",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
