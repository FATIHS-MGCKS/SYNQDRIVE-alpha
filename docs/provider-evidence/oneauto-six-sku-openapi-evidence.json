                      "description": "Whether the api call was successful"
                    },
                    "result": {
                      "type": "object",
                      "properties": {
                        "vehicle_identification_number": {
                          "type": "string",
                          "example": "ABCDE123456F78910",
                          "description": "Vehicle identification number (VIN)."
                        },
                        "normal_services": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "service_id": {
                                "type": "string",
                                "example": "SID1001",
                                "description": "ID for the service"
                              },
                              "service_interval_desc": {
                                "type": "string",
                                "example": "every 30000 km or 12 months",
                                "description": "Service interval description"
                              },
                              "service_months": {
                                "type": "integer",
                                "example": 12,
                                "description": "Service months."
                              },
                              "service_kms": {
                                "type": "integer",
                                "example": 30000,
                                "description": "Service interval in kilometres"
                              },
                              "service_miles": {
                                "type": "integer",
                                "example": 18641,
                                "description": "Service miles."
                              },
                              "service_description": {
                                "type": "string",
                                "example": "Engine Oil, Filter, interior air, Oil Filter, Sealing Plug, oil sump",
                                "description": "Service description"
                              },
                              "service_time_hours": {
                                "type": "number",
                                "example": 1,
                                "description": "The OE time for the service."
                              },
                              "service_tasks": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "task_id": {
                                      "type": "string",
                                      "example": "TID1001",
                                      "description": "ID for the task."
                                    },
                                    "task_description": {
                                      "type": "string",
                                      "example": "Outstanding campaigns and recalls",
                                      "description": "Task description"
                                    },
                                    "task_action": {
                                      "type": "string",
                                      "example": "Check",
                                      "description": "The required action"
                                    },
                                    "vehicle_position": {
                                      "type": "string",
                                      "example": "Vehicle On Floor",
                                      "description": "The position of the vehicle while carrying out the task"
                                    }
                                  }
                                }
                              },
                              "service_parts": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "part_number": {
                                      "type": "string",
                                      "example": "F026407231",
                                      "description": "Supplier part number"
                                    },
                                    "part_desc": {
                                      "type": "string",
                                      "example": "Oil Filter",
                                      "description": "Part description"
                                    },
                                    "supplier_id": {
                                      "type": "integer",
                                      "example": 30,
                                      "description": "ID for the supplier"
                                    },
                                    "supplier_desc": {
                                      "type": "string",
                                      "example": "BOSCH",
                                      "description": "Supplier name"
                                    },
                                    "part_grade": {
                                      "type": "string",
                                      "example": "Grade A",
                                      "description": "The grade of the part"
                                    },
                                    "oe_part_number": {
                                      "type": "string",
                                      "example": "074 115 562",
                                      "description": "OE part number"
                                    },
                                    "service_id": {
                                      "type": "string",
                                      "example": "SID1001",
                                      "description": "ID for the service"
                                    },
                                    "part_attributes": {
                                      "type": "array",
                                      "items": {
                                        "type": "object",
                                        "properties": {
                                          "name": {
                                            "type": "string",
                                            "example": "Outer diameter [mm]",
                                            "description": "Name of the attribute"
                                          },
                                          "value": {
                                            "type": "string",
                                            "example": "91",
                                            "description": "Attribute value."
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          }
                        },
                        "extra_services": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "service_id": {
                                "type": "string",
                                "example": "SID1075",
                                "description": "ID for the service"
                              },
                              "service_interval_desc": {
                                "type": "string",
                                "example": "every 300000 km,regardless of elapsed time",
                                "description": "Service interval description"
                              },
                              "service_months": {
                                "type": "integer",
                                "example": 24,
                                "description": "Service months."
                              },
                              "service_kms": {
                                "type": "integer",
                                "example": 300000,
                                "description": "Service interval in kilometres"
                              },
                              "service_miles": {
                                "type": "integer",
                                "example": 186412,
                                "description": "Service miles."
                              },
                              "service_description": {
                                "type": "string",
                                "example": "Timing Chain",
                                "description": "Service description"
                              },
                              "service_time_hours": {
                                "type": "number",
                                "example": 2.9,
                                "description": "The OE time for the service."
                              },
                              "service_tasks": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "task_id": {
                                      "type": "string",
                                      "example": "TID1001",
                                      "description": "ID for the task."
                                    },
                                    "task_description": {
                                      "type": "string",
                                      "example": "Timing chain(s)",
                                      "description": "Task description"
                                    },
                                    "task_action": {
                                      "type": "string",
                                      "example": "Renew",
                                      "description": "The required action"
                                    },
                                    "vehicle_position": {
                                      "type": "string",
                                      "example": "Engine Bay Operations",
                                      "description": "The position of the vehicle while carrying out the task"
                                    }
                                  }
                                }
                              },
                              "service_parts": {
                                "type": "array",
                                "items": {
                                  "type": "undefined"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
