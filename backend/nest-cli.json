{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "modules/clickhouse/migrations/*.sql",
        "outDir": "dist/src"
      },
      {
        "include": "modules/dimo/device-connection-physical-state/physical-state-cutover-evidence.ops-lib.cjs",
        "outDir": "dist/src"
      }
    ],
    "watchAssets": true
  }
}
