# Alertmanager notification secrets — copy to VPS and fill in values.
#
#   cp alertmanager.env.example /opt/synqdrive/shared/alertmanager/alertmanager.env
#   chmod 600 /opt/synqdrive/shared/alertmanager/alertmanager.env
#
# Used by: backend/scripts/ops/vps-setup-alertmanager.sh

# Slack incoming webhook (required for Slack notifications)
ALERTMANAGER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
ALERTMANAGER_SLACK_CHANNEL_WARNING=#synqdrive-alerts
ALERTMANAGER_SLACK_CHANNEL_CRITICAL=#synqdrive-critical

# SMTP (optional — email fallback when Slack unavailable)
ALERTMANAGER_SMTP_HOST=smtp.resend.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_FROM=alerts@synqdrive.eu
ALERTMANAGER_SMTP_USER=resend
ALERTMANAGER_SMTP_PASSWORD=re_xxxxxxxx

# Email recipients
ALERTMANAGER_EMAIL_WARNING=ops-warning@synqdrive.eu
ALERTMANAGER_EMAIL_CRITICAL=ops-oncall@synqdrive.eu
ALERTMANAGER_EMAIL_ESCALATION=ops-escalation@synqdrive.eu

# TLS probe target (blackbox_exporter)
ALERTMANAGER_SSL_PROBE_TARGET=https://app.synqdrive.eu
