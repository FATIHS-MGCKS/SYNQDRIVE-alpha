# SynqDrive infrastructure exporter secrets (VPS)
#
# Copy to: /opt/synqdrive/shared/exporters/exporters.env
# chmod 600 exporters.env
#
# Most values are auto-derived from backend.env by setup scripts.
# Override only when using non-default hosts/ports.

# PostgreSQL (optional override — default: parsed from DATABASE_URL)
# DATA_SOURCE_NAME=postgresql://synqdrive:xxx@127.0.0.1:5432/synqdrive?sslmode=disable

# Redis (optional override)
# REDIS_ADDR=127.0.0.1:6379
# REDIS_PASSWORD=

# Nginx stub_status URI for nginx-prometheus-exporter
NGINX_SCRAPE_URI=http://127.0.0.1:8081/nginx_status

# ClickHouse Prometheus scrape (native /metrics on port 9363)
CLICKHOUSE_PROMETHEUS_TARGET=127.0.0.1:9363
