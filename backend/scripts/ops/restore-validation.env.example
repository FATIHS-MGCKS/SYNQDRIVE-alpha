# SynqDrive restore validation (Phase 2C.6).
# Copy to: /opt/synqdrive/shared/restore-validation.env
# chmod 600 /opt/synqdrive/shared/restore-validation.env

RESTORE_VALIDATION_MODE=isolated
RESTORE_VALIDATION_ALLOW_PRODUCTION=false

# Isolated drill Postgres (separate instance or Docker on non-prod port — NOT production :5432/synqdrive)
RESTORE_VALIDATION_PG_HOST=127.0.0.1
RESTORE_VALIDATION_PG_PORT=55432
RESTORE_VALIDATION_PG_USER=synqdrive
RESTORE_VALIDATION_PG_PASSWORD=change-me
RESTORE_VALIDATION_PG_ADMIN_DB=postgres

# Isolated ClickHouse drill (non-prod port)
RESTORE_VALIDATION_CH_HOST=127.0.0.1
RESTORE_VALIDATION_CH_PORT=59000
RESTORE_VALIDATION_CH_USER=synqdrive
RESTORE_VALIDATION_CH_PASSWORD=change-me

# GPG for encrypted backup artifacts (shared with backup tiers)
# RESTORE_VALIDATION_GPG_PASSPHRASE_FILE=/root/.synqdrive-backup-passphrase
# RESTORE_VALIDATION_GPG_RECIPIENT=backup@synqdrive.eu

# Backup artifact directories (defaults match 2C.2–2C.5)
# RESTORE_VALIDATION_PG_BACKUP_DIR=/opt/synqdrive/shared/backups/postgresql/daily
# RESTORE_VALIDATION_CH_BACKUP_DIR=/opt/synqdrive/shared/backups/clickhouse/daily
# RESTORE_VALIDATION_REDIS_BACKUP_DIR=/opt/synqdrive/shared/backups/redis/daily
# RESTORE_VALIDATION_ENV_BACKUP_DIR=/opt/synqdrive/shared/backups/env/daily
# RESTORE_VALIDATION_UPLOADS_BACKUP_DIR=/opt/synqdrive/shared/backups/uploads/daily
# RESTORE_VALIDATION_DOCUMENTS_BACKUP_DIR=/opt/synqdrive/shared/backups/documents/daily

# Quarterly cron (UTC): 0 7 1 */3 *  — first day of quarter, 07:00
# RESTORE_VALIDATION_CRON_SCHEDULE="0 7 1 */3 *"
