# ClickHouse backup (production VPS).
# Copy to: /opt/synqdrive/shared/clickhouse-backup.env

# CLICKHOUSE_DATABASE=synqdrive
# CLICKHOUSE_USER=synqdrive
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_HOST=127.0.0.1
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_BACKUP_DISK_PATH=/opt/synqdrive/shared/clickhouse/backups

# CH_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu
# CH_BACKUP_GPG_PASSPHRASE_FILE=/root/.synqdrive-backup-passphrase
