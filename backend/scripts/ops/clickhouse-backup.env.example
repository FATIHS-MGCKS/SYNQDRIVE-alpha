# SynqDrive ClickHouse backup configuration (production VPS).
# Copy to: /opt/synqdrive/shared/clickhouse-backup.env
# chmod 600 /opt/synqdrive/shared/clickhouse-backup.env
#
# Credentials default from /opt/synqdrive/shared/backend.env if not set here.

# --- ClickHouse connection (via existing Docker container) ---
CH_BACKUP_CONTAINER=synqdrive-clickhouse
# CH_BACKUP_DATABASE=synqdrive
# CH_BACKUP_USER=synqdrive
# CH_BACKUP_PASSWORD=   # prefer backend.env

# --- Shared archive paths (outside release tree) ---
# CH_BACKUP_ROOT=/opt/synqdrive/shared/backups/clickhouse

# --- Safety ---
CH_BACKUP_MIN_GENERATIONS=2
CH_BACKUP_LOCAL_RETENTION_DAYS=14
CH_BACKUP_OFFSITE_RETENTION_DAYS=30
CH_BACKUP_CONTAINER_MOUNT_RETENTION_DAYS=7

# --- Encryption (required in production) ---
# Prefer full fingerprint via shared backup-gpg.env:
# SYNQDRIVE_BACKUP_GPG_FINGERPRINT=D50BCE8EB4A747F582B9D9C37439FE8C4034183A
# CH_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu
# CH_BACKUP_GPG_RECIPIENT_FINGERPRINT=   # optional tier override
# CH_BACKUP_GPG_PASSPHRASE_FILE=         # legacy symmetric — dev only
# CH_BACKUP_ALLOW_UNENCRYPTED=true   # dev only

# --- Offsite ---
# CH_BACKUP_OFFSITE_MODE=none
# CH_BACKUP_OFFSITE_MODE=rclone
# CH_BACKUP_RCLONE_REMOTE=hetzner:synqdrive-backups/clickhouse

# CH_BACKUP_OFFSITE_MODE=s3
# CH_BACKUP_S3_URI=s3://your-bucket/synqdrive/clickhouse

# --- Restore test ---
# CH_BACKUP_RESTORE_TEST_DB=synqdrive_restore_test

# --- Cron (UTC) — default 03:30, after PostgreSQL 02:00 ---
# CH_BACKUP_CRON_SCHEDULE="30 3 * * *"
