# Install on VPS as root-owned, mode 0444:
#   /opt/synqdrive/shared/vo5c-production-deploy-authority.env
#
# Do NOT activate until P4B16+ operational runbook sign-off.
# This file is the sole switch for production deploy bypass enforcement (not overridable via deploy env).
#
# When setting VO5C_PRODUCTION_DEPLOY_ENFORCEMENT_ACTIVE=1, also create (root:root 0444):
#   /opt/synqdrive/shared/vo5c-production-deploy-enforcement-armed
# If that stamp exists, a missing or invalid authority file FAILS CLOSED (no silent fail-open).
# Monitor: alert when stamp exists but authority file is absent, dangling symlink, or unreadable.

VO5C_PRODUCTION_DEPLOY_ENFORCEMENT_ACTIVE=0

# Must match /opt/synqdrive/shared/vo5c-pinned-executor.env when enforcement is enabled.
SYNQDRIVE_PINNED_EXECUTOR_ROOT=/opt/synqdrive/shared/pinned-executor/dc30d2c91e458603c7d45ba2e25c1ca0a1d0c672
SYNQDRIVE_PINNED_EXECUTOR_SHA=dc30d2c91e458603c7d45ba2e25c1ca0a1d0c672
