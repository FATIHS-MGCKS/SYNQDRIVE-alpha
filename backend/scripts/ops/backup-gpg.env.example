# SynqDrive shared backup GPG configuration (production VPS).
# Copy to: /opt/synqdrive/shared/backup-gpg.env
# chmod 600 /opt/synqdrive/shared/backup-gpg.env
#
# Production uses public-key recipient encryption only.
# Import the public key with: vps-setup-backup-gpg.sh
# Private recovery key must NOT live on the production VPS.

# Canonical recipient (email label for operators)
SYNQDRIVE_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu

# Full 40-character fingerprint (required in production)
# Example from keys/synqdrive-backup-recovery.pub.asc — replace after key rotation
SYNQDRIVE_BACKUP_GPG_FINGERPRINT=D50BCE8EB4A747F582B9D9C37439FE8C4034183A

# Dedicated keyring for backup automation (cron sets GNUPGHOME to this path)
GPG_BACKUP_HOME=/opt/synqdrive/shared/gpg-backup

# Legacy symmetric encryption (dev / migration only — not for production)
# SYNQDRIVE_BACKUP_GPG_PASSPHRASE_FILE=/opt/synqdrive/shared/secrets/backup.pass
