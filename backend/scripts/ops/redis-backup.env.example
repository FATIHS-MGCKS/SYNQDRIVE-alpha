# SynqDrive Redis backup & persistence (production VPS).
# Copy to: /opt/synqdrive/shared/redis-backup.env
# chmod 600 /opt/synqdrive/shared/redis-backup.env

# --- Redis connection (defaults from backend.env) ---
# REDIS_BACKUP_HOST=127.0.0.1
# REDIS_BACKUP_PORT=6379
# REDIS_BACKUP_PASSWORD=
# REDIS_BACKUP_DB=0

# --- Archives ---
# REDIS_BACKUP_ROOT=/opt/synqdrive/shared/backups/redis

# --- Safety ---
REDIS_BACKUP_MIN_GENERATIONS=2
REDIS_BACKUP_LOCAL_RETENTION_DAYS=7

# --- Encryption (recommended — can share PostgreSQL backup GPG key) ---
# REDIS_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu
# REDIS_BACKUP_GPG_PASSPHRASE_FILE=/root/.synqdrive-backup-passphrase
# REDIS_BACKUP_ALLOW_UNENCRYPTED=true   # dev only

# --- Offsite (prefer central orchestrator — see offsite-backup.env.example) ---
# When OFFSITE_CENTRAL_SYNC=true in offsite-backup.env, leave this enabled:
REDIS_BACKUP_SKIP_OFFSITE=true
# Legacy per-tier offsite (only if OFFSITE_CENTRAL_SYNC=false):
# REDIS_BACKUP_OFFSITE_MODE=rclone
# REDIS_BACKUP_RCLONE_REMOTE=hetzner:synqdrive-backups/redis

# --- Persistence tuning (vps-configure-redis-persistence.sh) ---
# REDIS_PERSISTENCE_MAXMEMORY_MB=512

# --- Cron (UTC) — default 04:00 after PG/CH backups ---
# REDIS_BACKUP_CRON_SCHEDULE="0 4 * * *"
