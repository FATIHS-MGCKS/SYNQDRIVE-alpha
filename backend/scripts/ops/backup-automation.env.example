# SynqDrive unified backup automation (Phase 2C.7).
# Copy to: /opt/synqdrive/shared/backup-automation.env
# chmod 600 /opt/synqdrive/shared/backup-automation.env

# --- Notifications (falls back to OFFSITE_NOTIFY_EMAIL) ---
BACKUP_AUTOMATION_NOTIFY_EMAIL=ops@your-domain.eu

# --- Retry policy ---
BACKUP_AUTOMATION_DEFAULT_RETRIES=3
BACKUP_AUTOMATION_DEFAULT_BACKOFF_SEC=120

# --- State + metrics ---
# BACKUP_AUTOMATION_STATE_DIR=/opt/synqdrive/shared/backups/automation/state
# BACKUP_AUTOMATION_LOG_DIR=/var/log/synqdrive-backup
# BACKUP_AUTOMATION_METRICS_FILE=/opt/synqdrive/shared/backups/automation/metrics.prom

# --- Cron schedules (UTC) — override before vps-install-backup-automation-cron.sh ---
# BACKUP_PG_CRON_SCHEDULE="0 2 * * *"
# BACKUP_CH_CRON_SCHEDULE="30 3 * * *"
# BACKUP_REDIS_CRON_SCHEDULE="0 4 * * *"
# BACKUP_ENV_CRON_SCHEDULE="15 5 * * *"
# BACKUP_OFFSITE_CRON_SCHEDULE="15 5 * * *"
# BACKUP_OFFSITE_VERIFY_CRON_SCHEDULE="30 6 * * 0"
# BACKUP_HEALTH_CRON_SCHEDULE="45 6 * * *"
