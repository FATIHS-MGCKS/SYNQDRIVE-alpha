# SynqDrive PostgreSQL backup configuration (production VPS).
# Copy to: /opt/synqdrive/shared/postgresql-backup.env
# chmod 600 /opt/synqdrive/shared/postgresql-backup.env
#
# Used by:
#   backend/scripts/ops/vps-backup-database.sh
#   backend/scripts/ops/vps-restore-test-database.sh

# --- Database ---
PG_BACKUP_DB_NAME=synqdrive
PG_BACKUP_PG_USER=postgres

# --- Paths (defaults usually fine on VPS) ---
# PG_BACKUP_ROOT=/opt/synqdrive/shared/backups/postgresql
# PG_BACKUP_ARCHIVE_DIR=/opt/synqdrive/shared/backups/postgresql/daily

# --- Labels (set by caller for deploy; daily cron uses "daily") ---
# PG_BACKUP_LABEL=daily

# --- Safety ---
PG_BACKUP_MIN_GENERATIONS=2
PG_BACKUP_LOCAL_RETENTION_DAYS=30
PG_BACKUP_OFFSITE_RETENTION_DAYS=90
PG_BACKUP_DISK_WARN_PCT=85
PG_BACKUP_DISK_ABORT_PCT=90

# --- Encryption (required in production) ---
# Option A: asymmetric (recommended) — import public key on VPS
# PG_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu

# Option B: symmetric passphrase file (chmod 600, root-only)
# PG_BACKUP_GPG_PASSPHRASE_FILE=/root/.synqdrive-backup-passphrase

# Dev/staging only — never on production
# PG_BACKUP_ALLOW_UNENCRYPTED=true

# --- Offsite copy ---
# PG_BACKUP_OFFSITE_MODE=none
# PG_BACKUP_OFFSITE_MODE=rclone
# PG_BACKUP_RCLONE_REMOTE=hetzner:synqdrive-backups/postgresql

# PG_BACKUP_OFFSITE_MODE=s3
# PG_BACKUP_S3_URI=s3://your-bucket/synqdrive/postgresql

# --- Restore test database ---
# PG_BACKUP_RESTORE_TEST_DB=synqdrive_restore_test

# --- Cron installer override ---
# PG_BACKUP_CRON_SCHEDULE="0 2 * * *"
