# SynqDrive PostgreSQL backup configuration (production VPS).
# Copy to: /opt/synqdrive/shared/postgresql-backup.env
# chmod 600 /opt/synqdrive/shared/postgresql-backup.env
#
# Credentials default from DATABASE_URL in /opt/synqdrive/shared/backend.env

PG_BACKUP_MIN_GENERATIONS=2
PG_BACKUP_LOCAL_RETENTION_DAYS=14

# Shared GPG recipient — see backup-gpg.env.example
# PG_BACKUP_GPG_RECIPIENT_FINGERPRINT inherits from SYNQDRIVE_BACKUP_GPG_FINGERPRINT

# Cron (UTC) — default 02:00 before ClickHouse/Redis
# PG_BACKUP_CRON_SCHEDULE="0 2 * * *"
