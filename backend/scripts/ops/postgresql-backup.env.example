# PostgreSQL backup (production VPS).
# Copy to: /opt/synqdrive/shared/postgresql-backup.env

# DATABASE_URL loaded from backend.env by default

# PG_BACKUP_GPG_RECIPIENT=backup@synqdrive.eu
# PG_BACKUP_GPG_PASSPHRASE_FILE=/root/.synqdrive-backup-passphrase
# PG_BACKUP_ALLOW_UNENCRYPTED=false
# PG_BACKUP_SKIP_OFFSITE=true
