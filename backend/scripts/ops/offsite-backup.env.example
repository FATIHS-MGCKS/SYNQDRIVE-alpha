# SynqDrive unified offsite backup configuration.
# Copy to: /opt/synqdrive/shared/offsite-backup.env
# chmod 600 /opt/synqdrive/shared/offsite-backup.env

# --- Required in production ---
OFFSITE_REQUIRED=true
OFFSITE_MODE=rclone
OFFSITE_PATH_PREFIX=production

# rclone remote (configure via rclone.conf or setup script)
OFFSITE_RCLONE_REMOTE=offsite:synqdrive-backups

# S3-compatible credentials (setup script writes /opt/synqdrive/shared/secrets/rclone.conf)
# OFFSITE_S3_ENDPOINT=https://your-account.eu-central-1.linodeobjects.com
# OFFSITE_S3_ACCESS_KEY_ID=
# OFFSITE_S3_SECRET_ACCESS_KEY=
# OFFSITE_S3_BUCKET=synqdrive-backups

# Alternative native S3 mode:
# OFFSITE_MODE=s3
# OFFSITE_S3_URI=s3://your-bucket/production

# --- Central orchestrator (recommended) ---
# When true, tier backup scripts should set *_SKIP_OFFSITE=true
OFFSITE_CENTRAL_SYNC=true

# --- Encryption policy ---
OFFSITE_REQUIRE_ENCRYPTION=true
OFFSITE_GPG_RECIPIENT=backup@synqdrive.eu
# Fingerprint (verification only): D50BCE8EB4A747F582B9D9C37439FE8C4034183A

# --- Notifications (Resend via backend.env) ---
OFFSITE_NOTIFY_EMAIL=ops@synqdrive.eu
OFFSITE_NOTIFY_ON_SUCCESS=false

# --- Tier retention: name:local_dir:remote_subpath:days:min_generations ---
# Remote paths are prefixed with OFFSITE_PATH_PREFIX (e.g. production/postgresql/)
# OFFSITE_TIER_POSTGRESQL=postgresql:/opt/synqdrive/shared/backups/postgresql/daily:postgresql:90:2
# OFFSITE_TIER_CLICKHOUSE=clickhouse:/opt/synqdrive/shared/backups/clickhouse/daily:clickhouse:30:2
# OFFSITE_TIER_REDIS=redis:/opt/synqdrive/shared/backups/redis/daily:redis:30:2
# OFFSITE_TIER_ENV=env:/opt/synqdrive/shared/backups/env/daily:env:90:2

# --- Monitoring ---
# OFFSITE_RESILIENCE_JSON=/opt/synqdrive/shared/resilience-status.json
# OFFSITE_PROM_TEXTFILE=/opt/synqdrive/shared/node-exporter-textfile/synqdrive_backup.prom

# --- Cron (UTC) ---
# OFFSITE_CRON_SCHEDULE="15 5 * * *"
# OFFSITE_VERIFY_CRON_SCHEDULE="30 6 * * 0"
