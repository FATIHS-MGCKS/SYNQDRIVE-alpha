<?xml version="1.0"?>
<!--
  Phase 2D.7 — batch small snapshot inserts server-side (2D.5 IN1).
  wait_for_async_insert=1 preserves durability before ACK to client.
-->
<clickhouse>
    <profiles>
        <default>
            <async_insert>1</async_insert>
            <wait_for_async_insert>1</wait_for_async_insert>
            <async_insert_max_data_size>1048576</async_insert_max_data_size>
            <async_insert_busy_timeout_max_ms>1000</async_insert_busy_timeout_max_ms>
        </default>
    </profiles>
</clickhouse>
