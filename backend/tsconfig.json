{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@modules/*": ["src/modules/*"],
      "@workers/*": ["src/workers/*"],
      "@config/*": ["src/config/*"],
      "@synq/evaluations-metrics/*": ["src/synq/evaluations-metrics/*"],
      "@synq/evaluations-periods/*": ["src/synq/evaluations-periods/*"],
      "@synq/evaluations-analytics/*": ["src/synq/evaluations-analytics/*"],
      "@synq/evaluations-finance/*": ["src/synq/evaluations-finance/*"],
      "@synq/evaluations-recommendations/*": ["src/synq/evaluations-recommendations/*"]
    }
  }
}
